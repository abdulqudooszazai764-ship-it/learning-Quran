# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to any public place.

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://academy_user:academy_password@localhost:5432/quran_academy

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_value
JWT_EXPIRES_IN=7d

# First admin (teacher) account - used only once by db/setup.js to create the
# first login. You can change the teacher's name/photo later from the dashboard.
FIRST_ADMIN_NAME=Ustadh Admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeThisPassword123!

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173
