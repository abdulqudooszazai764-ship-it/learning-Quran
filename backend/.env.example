DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgresql://academy_user:change-me@127.0.0.1:5432/quran_academy
FRONTEND_ORIGIN=http://localhost:3000

# Gmail SMTP for admission notifications (use App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=academy@example.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=academy@example.com
ADMISSION_NOTIFY_EMAIL=academy@example.com
